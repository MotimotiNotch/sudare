{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sudare",
  "version": "0.1.0",
  "identifier": "jp.motimotinotch.sudare",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run build:web",
    "beforeBuildCommand": "bun run build:web"
  },
  "app": {
    "windows": [
      { "title": "Sudare", "width": 1440, "height": 920, "minWidth": 960, "minHeight": 640, "theme": "Dark" }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../licenses/THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../licenses/RUST_STD_COPYRIGHT.html": "RUST_STD_COPYRIGHT.html"
    },
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
